#!/bin/sh
# Hook entry for Claude Code (invoked as `sh .../thaliris-hook <Event> [--filter]`,
# the same convention as Anthropic's own plugins).
#
# The user-scoped PreToolUse hook has a fast path for unrelated tools. Foreign
# sessions and relays need the hook for every tool. Agent routing and messaging
# also need Python even when the payload does not mention Thaliris.
event=$1
bin_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
home=${THALIRIS_CLAUDE_HOME:-$HOME/.thaliris/claude}
selectors=${USERPROFILE:-$HOME}/.thaliris/xhost-sessions

has_task() {
  for association in "$home"/sessions/*.json; do
    [ -e "$association" ] && return 0
  done
  return 1
}

if [ "$event" = "UserPromptSubmit" ] && ! has_task; then
  exit 0
fi
# `--lane`: Controller tool results for the adaptive lane counter. Only a session whose task is adaptive has a marker
# (`$home/lane/<session_id>`, written at admission/attach/mode switch, removed at close/detach/switch away); every
# other session exits here without starting Python. The session id is read by parameter expansion (no process); an
# id that is not a plain filename has a hashed marker, found only by the any-marker fallback. Python re-checks.
if [ "$2" = "--lane" ]; then
  [ -d "$home/lane" ] || exit 0
  payload=$(cat)
  rest=${payload#*\"session_id\"}
  rest=${rest#*\"}
  session=${rest%%\"*}
  case $session in
    ''|*[!A-Za-z0-9-]*)
      found=
      for marker in "$home"/lane/*; do
        [ -e "$marker" ] && found=1 && break
      done
      [ -n "$found" ] || exit 0 ;;
    *) [ -f "$home/lane/$session" ] || exit 0 ;;
  esac
fi
[ "$2" = "--lane" ] || payload=$(cat)
has_selector() {
  [ -d "$selectors" ] || return 1
  command -v sha256sum >/dev/null 2>&1 || return 0
  rest=${payload#*\"session_id\"}
  rest=${rest#*\"}
  session=${rest%%\"*}
  case $session in
    ''|*[!A-Za-z0-9._:-]*) return 0 ;;
  esac
  digest=$(printf '%s' "$session" | sha256sum) || return 0
  selector=$selectors/${digest%% *}.json
  [ -e "$selector" ] || [ -L "$selector" ]
}
if [ "$2" = "--filter" ] && [ -z "${AGENT_BRIDGE_DEPTH:-}${THALIRIS_FOREIGN_CHILD:-}" ] && ! has_selector; then
  rest=${payload#*\"tool_name\"}
  rest=${rest#*\"}
  tool=${rest%%\"*}
  case $tool in
    Agent|Task|SendMessage|Skill) ;;
    *) case $payload in
      *'"agent_id"'*) ;;
      *[Tt][Hh][Aa][Ll][Ii][Rr][Ii][Ss]*|*.[Cc][Oo][Nn][Tt][Ee][Xx][Tt]*|*[Ss][Ee][Tt][Tt][Ii][Nn][Gg][Ss]*|*[Ll][Ii][Ff][Ee][Cc][Yy][Cc][Ll][Ee]*|*[Cc][Ll][Aa][Uu][Dd][Ee]-[Rr][Oo][Ll][Ee][Ss]*|*[Pp][Rr][Oo][Jj][Ee][Cc][Tt]-[Ii][Dd][Ee][Nn][Tt][Ii][Tt][Yy]*) ;;
      *) exit 0 ;;
    esac ;;
  esac
fi

run() {
  printf '%s' "$payload" | "$@" "$bin_dir/thaliris.py" hook "$event"
  exit $?
}

if [ -z "$THALIRIS_CLAUDE_PYTHON" ] && [ -f "$home/runtime/python" ]; then
  cached=$(cat "$home/runtime/python")
  if [ -n "$cached" ] && [ -f "$cached" ]; then
    run "$cached"
  fi
fi

for candidate in python3 python py; do
  # `-c` without stdin: a Windows Store stub fails here harmlessly.
  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c "import sys" </dev/null >/dev/null 2>&1; then
    run "$candidate"
  fi
done
# With no usable interpreter, passing a managed foreign tool through would lose
# its boundary. An ordinary plugin process still degrades to transparent.
if [ "$event" = "PreToolUse" ]; then
  case "${THALIRIS_FOREIGN_CHILD:-}:$payload" in
    1:*|*'thaliris:codex-'*) printf '%s' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Thaliris foreign runtime is unavailable"}}' ;;
    *) ! has_selector || printf '%s' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Thaliris foreign selector cannot be verified"}}' ;;
  esac
fi
exit 0
